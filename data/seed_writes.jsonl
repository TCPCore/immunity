{"label": "AntibodyInjected", "cypher": "\n            CREATE (ab:Antibody {id: $id, correction_text: $correction_text,\n                                 strategy: $strategy, outcome: $outcome,\n                                 created_at: $created_at})\n            ", "params": {"id": "ab_54c534d640", "correction_text": "Immunity recall: this restates 'Mars has breathable oxygen at night', which was quarantined after an unsupported_root infection first seen 2026-10-16T08:25:39+00:00.", "strategy": "immunity_recall", "outcome": "effective", "created_at": "2026-10-16T08:25:39+00:00"}}
{"label": "AntibodyInjected", "cypher": "\n            MATCH (ab:Antibody {id: $abid}), (i:Infection {id: $iid})\n            MERGE (ab)-[:NEUTRALIZES]->(i)\n            ", "params": {"abid": "ab_54c534d640", "iid": "inf_83f133661e"}}
