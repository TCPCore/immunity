# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# --- FalkorDB connection (works for local Docker OR FalkorDB Cloud) ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USER=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=immunegraph
# Free-tier FalkorDB Cloud has no TLS; set to true only on paid tiers.
FALKORDB_TLS=false

# --- Claim extraction ---
# llm = LLM only | rule = deterministic only | auto = LLM with rule fallback
EXTRACTOR=auto

# --- LLM (any OpenAI-compatible endpoint) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- App ---
TENANT_ID=default

# --- Durability ---
# Every write is appended here before it is applied, so the graph can be
# rebuilt. FalkorDB Cloud's free tier has no persistence, so this is what
# makes the graph recoverable.
WRITE_LOG_PATH=/tmp/immunegraph-writes.db
# Optional committed seed log, replayed on a cold start so a freshly deployed
# app has data without anyone clicking anything. data/seed_writes.jsonl is the
# Mars run, generated with:
#   python -m immunegraph.demo --export-seed data/seed_writes.jsonl
# Leave blank to start empty.
SEED_LOG=
