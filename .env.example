# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# --- FalkorDB connection (works for local Docker OR FalkorDB Cloud) ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USER=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=immunegraph
# Free-tier FalkorDB Cloud has no TLS; set to true only on paid tiers.
FALKORDB_TLS=false

# --- Claim extraction ---
# llm = LLM only | rule = deterministic only | auto = LLM with rule fallback
EXTRACTOR=auto

# --- LLM (any OpenAI-compatible endpoint) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- App ---
TENANT_ID=default
